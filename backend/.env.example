# PolarNav AI - Backend Environment Template
# Copy this file to `backend/.env` and supply your credentials

# Server & Runtime
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# AISStream.io Live Fleet Tracking
# Obtain API key from https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key_here
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_RECONNECT_DELAY_SECONDS=5.0

# Remote Sensing & Environmental APIs
NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
COPERNICUS_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Map & GIS Provider (Optional for backend raster/vector queries)
MAPTILER_API_KEY=

# AI & LLM Advisory Engine
OLLAMA_HOST=http://localhost:11434
POLARNAV_LLM_MODEL=llama3
GEMINI_API_KEY=
